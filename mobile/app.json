{
  "expo": {
    "name": "Personel Servis Surucu",
    "slug": "personel-servis-driver-mobile",
    "scheme": "psdriver",
    "version": "0.2.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.personelservis.driver",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.personelservis.driver",
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "extra": {
      "appRole": "DRIVER",
      "releaseStage": "m57-mobile-hardening",
      "androidPreviewTrack": "preview-internal",
      "productionTrack": "production",
      "eas": {
        "projectId": "e08c9aa3-26d9-4e58-88fb-8ddffa8824d9"
      }
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Saklanan oturum bilgisini korumak icin biyometrik dogrulamaya izin ver."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Surucunun telefon GPS'i ile gorev sirasinda konum guncellemek icin izin gerekir.",
          "locationAlwaysAndWhenInUsePermission": "Surucunun telefon GPS'i ile gorev sirasinda konum guncellemek icin izin gerekir.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    }
  }
}
