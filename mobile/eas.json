{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://auburn-answer-advocacy-physician.trycloudflare.com",
        "EXPO_PUBLIC_RELEASE_STAGE": "preview-internal"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.example.com",
        "EXPO_PUBLIC_RELEASE_STAGE": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
