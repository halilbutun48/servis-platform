{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "__SET_PREVIEW_HTTPS_API_BASE_URL__",
        "EXPO_PUBLIC_RELEASE_STAGE": "preview-internal",
        "EXPO_PUBLIC_API_TIMEOUT_MS": "12000"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {},
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "__SET_PRODUCTION_HTTPS_API_BASE_URL__",
        "EXPO_PUBLIC_RELEASE_STAGE": "production",
        "EXPO_PUBLIC_API_TIMEOUT_MS": "12000"
      }
    },
    "preview-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "__SET_PREVIEW_SIMULATOR_HTTPS_API_BASE_URL__",
        "EXPO_PUBLIC_RELEASE_STAGE": "preview-simulator",
        "EXPO_PUBLIC_API_TIMEOUT_MS": "12000"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
