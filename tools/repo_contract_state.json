  "shareablePackageHygiene": {
    "policyVersion": 1,
    "goal": "shareable-package-clean-export",
    "principles": [
      "line-count reduction stays deferred until after acceptance and hygiene closure",
      "shareable exports must exclude workspace secrets, build artifacts, runtime json stores, and transient overlay/log residues",
      "repo hygiene preflight may remove only safe transient residues from the working tree",
      "artifacts stay local and are never part of the shareable repo bundle"
    ],
    "forbiddenExactFiles": [
      ".env",
      "backend/.env",
      "infra/.env",
      "pack_living_final.log",
      "pack_living_latest.log"
    ],
    "forbiddenGlobFiles": [
      "backend/data/*.json",
      "README_M*_OVERLAY*.txt",
      "*.zip"
    ],
    "forbiddenPathPrefixes": [
      ".git/",
      "node_modules/",
      "artifacts/",
      ".next/",
      "dist/",
      "build/",
      "coverage/",
      "_archive/",
      "_backup/",
      "infra/osrm-data/",
      "web/dist/",
      "mobile/dist/"
    ],
    "preflightTransientTargets": [
      "web/dist",
      "mobile/dist",
      "pack_living_final.log",
      "pack_living_latest.log",
      "README_M*_OVERLAY*.txt"
    ],
    "exportTool": "tools/export_shareable_repo_bundle.ps1"
  },
  "ciVerificationVisibility": {
    "goal": "repo-native-ci-verification-visibility",
    "workflowPath": ".github/workflows/vardis_verification_visibility.yml",
    "primaryCommand": "npm run verify:ci",
    "exportPack": "tools/pack_m90_c7_export_package_hygiene.ps1",
    "jobs": [
      "repo-verification",
      "shareable-export"
    ],
    "artifacts": [
      "artifacts/repo-audit/repo_audit_latest.json",
      "artifacts/shareable-export/servis-platform_shareable_*.zip"
    ]
  },
  "safeClosureFinalHygiene": {
    "goal": "safe-closure-final-hygiene-checklist",
    "primaryCommand": "npm run verify:final",
    "windowsPreferredShell": "pwsh",
    "exportPack": "tools/pack_m90_c7_export_package_hygiene.ps1",
    "exportTool": "tools/export_shareable_repo_bundle.ps1",
    "orderedSteps": [
      "npm run verify:final",
      "pwsh -ExecutionPolicy Bypass -File .\\tools\\pack_m90_c7_export_package_hygiene.ps1 -RepoRoot D:\\servis-platform",
      "pwsh -ExecutionPolicy Bypass -File .\\tools\\export_shareable_repo_bundle.ps1 -RepoRoot D:\\servis-platform",
      "git status --short",
      "git add -A && git commit / tag / push only after expected diff is confirmed"
    ],
    "compatibilityNotes": [
      "On Windows, prefer pwsh for export-related packs and shareable bundle generation",
      "export_shareable_repo_bundle.ps1 must stay compatible with Windows PowerShell 5.1 fallback semantics even when pwsh is preferred",
      "line-count reduction stays deferred until after acceptance, hygiene, export, and CI closure work"
    ]
  }
