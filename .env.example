# servis-platform example environment variables
# Root env (docker compose reads)
POSTGRES_USER=servis
POSTGRES_PASSWORD=servispass
POSTGRES_DB=servisdb
POSTGRES_PORT=5433

# JWT_SECRET is required in production; dev/test may fall back to dev-secret
JWT_SECRET=dev_secret_change_me
PRIVILEGED_ACCESS_TOKEN_EXPIRES_IN=1 week
STEP_UP_ENABLED=0
STEP_UP_PROVIDER=none
STEP_UP_REQUIRED_ROLES=SUPER_ADMIN,ROOM,COMPANY
STEP_UP_TOTP_ENABLED=0
TOTP_SECRET_VAULT_KEY=change_me_or_leave_blank_for_jwt_fallback
# 0 = hazırlık / dormant, 1 = activation gate hazır
PAYMENT_BACKBONE_ENABLED=0
API_PORT=3000

# M93 auto-reached queue guardrails
AUTO_REACHED_LOCK_TTL_MS=120000
AUTO_REACHED_PROCESSING_TTL_MS=300000
AUTO_REACHED_RECLAIM_SWEEP_MS=60000
AUTO_REACHED_MAX_ATTEMPTS=3
AUTO_REACHED_QUEUE_DEPTH_WARN=500
AUTO_REACHED_PROCESSING_DEPTH_WARN=50
AUTO_REACHED_CLAIMS_DEPTH_WARN=50
AUTO_REACHED_DEAD_LETTER_DEPTH_WARN=1
AUTO_REACHED_OLDEST_CLAIM_AGE_MS_WARN=120000

# ✅ M19: route learning (optional)
# OSRM_URL=http://localhost:5000
# ROUTE_LEARN_ENABLED=1
# ROUTE_LEARN_INTERVAL_MS=30000

# ✅ M42: optional check-in module
# FEATURE_CHECKIN=1
# CHECKIN_DEDUPE_SEC=60

# Step 2 / M43: Google Auth (GIS)
# GOOGLE_AUTH_ENABLED=1
# GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Açmak için örnek:
# STEP_UP_ENABLED=1
# STEP_UP_PROVIDER=totp
# STEP_UP_TOTP_ENABLED=1

# Step 2.5 / M44: telematics
# TELEMATICS_ENABLED=1
# TELEMATICS_VENDOR_SECRET_GENERIC=dev_telematics_vendor_secret_generic
# TELEMATICS_VENDOR_SECRET_TRACCAR=dev_telematics_vendor_secret_traccar
# TELEMATICS_VENDOR_SHARED_SECRET=dev_telematics_vendor_legacy_secret
# TELEMATICS_VENDOR_SHARED_SECRET_LEGACY_ALLOWED=0
# TELEMATICS_VENDOR_REPLAY_WINDOW_SEC=300
# TELEMATICS_RATE_LIMIT_WINDOW_MS=60000
# TELEMATICS_RATE_LIMIT_MAX=240
# TELEMATICS_HISTORY_MIN_SEC=30
# TELEMATICS_HISTORY_MIN_METERS=50

# Local test-only bypasses
# GREENPACK_BYPASS_ENABLED=1

# Step 2.6 / M45: retention + backup ops
# LOG_RETENTION_ENABLED=1
# API_REQUEST_RETENTION_DAYS=730
# AUDIT_LOG_RETENTION_DAYS=730
# BACKUP_LOCAL_DIR=/app/artifacts/backups
# BACKUP_LOCAL_RETENTION_DAYS=730
# BACKUP_DUMP_FORMAT=plain
# NOTIFICATION_RETENTION_DAYS=180
# CHECKIN_EVENT_RETENTION_DAYS=180
# GPS_POINT_RETENTION_DAYS=30

# M46 AI Copilot Foundation
AI_COPILOT_ENABLED=1

# M47.2 capacity / load baseline
# CAPACITY_BASELINE_ENABLED=1
# CAPACITY_BASELINE_WINDOW_MINUTES=15
# CAPACITY_BASELINE_WARN_RPM=300
# CAPACITY_BASELINE_WARN_P95_MS=1200
# CAPACITY_BASELINE_WARN_429_RATIO_PCT=5
# CAPACITY_BASELINE_WARN_INFLIGHT=60
# CAPACITY_BASELINE_WARN_WS_CONNECTIONS=500
# CAPACITY_BASELINE_WARN_EVENT_LOOP_LAG_MS=250
# EDGE_SECURITY_ENABLED=1
# EDGE_SECURITY_HEADERS_ENABLED=1
# EDGE_BLOCK_SUSPICIOUS_UA=1
# EDGE_BLOCK_TRACE_METHOD=1
# EDGE_BLOCKED_UA_NEEDLES=sqlmap,nikto,masscan,nmap,zgrab,acunetix,nessus
# EDGE_SNAPSHOT_WINDOW_MINUTES=60
# EDGE_WARN_5XX_RATIO_PCT=3
# EDGE_WARN_429_RATIO_PCT=5
# TRUST_PROXY_HOPS=1

# #2 external cost/reference boundary (no default network provider)
# EXTERNAL_REFERENCE_MANUAL_IMPORT_ENABLED=1
# EXTERNAL_REFERENCE_PROVIDER=none
# EXTERNAL_REFERENCE_CACHE_TTL_MS=30000
# EXTERNAL_REFERENCE_RETRY_MAX_ATTEMPTS=2
OSRM_URL=http://osrm:5000
PLAN_SOLVER_URL=http://solver:8000
