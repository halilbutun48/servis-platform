# servis-platform example environment variables
# Root env (docker compose reads)
POSTGRES_USER=servis
POSTGRES_PASSWORD=servispass
POSTGRES_DB=servisdb
POSTGRES_PORT=5433

JWT_SECRET=dev_secret_change_me
API_PORT=3000

# ✅ M19: route learning (optional)
# OSRM_URL=http://localhost:5000
# ROUTE_LEARN_ENABLED=1
# ROUTE_LEARN_INTERVAL_MS=30000

# ✅ M42: optional check-in module
# FEATURE_CHECKIN=1
# CHECKIN_DEDUPE_SEC=60

# Step 2 / M43: Google Auth (GIS)
# GOOGLE_AUTH_ENABLED=1
# GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Step 2.5 / M44: telematics
# TELEMATICS_ENABLED=1
# TELEMATICS_VENDOR_SHARED_SECRET=dev_telematics_vendor_secret
# TELEMATICS_RATE_LIMIT_WINDOW_MS=60000
# TELEMATICS_RATE_LIMIT_MAX=240
# TELEMATICS_HISTORY_MIN_SEC=30
# TELEMATICS_HISTORY_MIN_METERS=50

# Step 2.6 / M45: retention + backup ops
# BACKUP_LOCAL_DIR=/app/artifacts/backups
# BACKUP_LOCAL_RETENTION_DAYS=14
# BACKUP_DUMP_FORMAT=plain

# M46 AI Copilot Foundation
AI_COPILOT_ENABLED=1

# M47.2 capacity / load baseline
# CAPACITY_BASELINE_ENABLED=1
# CAPACITY_BASELINE_WINDOW_MINUTES=15
# CAPACITY_BASELINE_WARN_RPM=300
# CAPACITY_BASELINE_WARN_P95_MS=1200
# CAPACITY_BASELINE_WARN_429_RATIO_PCT=5
# CAPACITY_BASELINE_WARN_INFLIGHT=60
# CAPACITY_BASELINE_WARN_WS_CONNECTIONS=500
# CAPACITY_BASELINE_WARN_EVENT_LOOP_LAG_MS=250
# EDGE_SECURITY_ENABLED=1
# EDGE_SECURITY_HEADERS_ENABLED=1
# EDGE_BLOCK_SUSPICIOUS_UA=1
# EDGE_BLOCK_TRACE_METHOD=1
# EDGE_BLOCKED_UA_NEEDLES=sqlmap,nikto,masscan,nmap,zgrab,acunetix,nessus
# EDGE_SNAPSHOT_WINDOW_MINUTES=60
# EDGE_WARN_5XX_RATIO_PCT=3
# EDGE_WARN_429_RATIO_PCT=5
# TRUST_PROXY_HOPS=1
