// PERSONEL-SERVIS V1 — Prisma schema (PostgreSQL)
//
// Tek kaynak doküman hedefi:
// - docs/PROJECT_SPEC_V1.md
// - docs/API_SPEC_V1.md
// - docs/DB_SCHEMA_V1.md
//
// Not: Bu schema, kullanıcıların yapıştırdığı PRIMER + Mermaid DB şemasına göre
// sadeleştirilmiş çekirdek veri modelidir (Milestone-0 / iskelet).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

// #11 canonical modular schema root: domain declarations live under ./schema.
// Prisma 5.22 loads this folder natively via prismaSchemaFolder.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
