// PERSONEL-SERVIS V1 — Prisma schema (PostgreSQL)
//
// Tek kaynak doküman hedefi:
// - docs/PROJECT_SPEC_V1.md
// - docs/API_SPEC_V1.md
// - docs/DB_SCHEMA_V1.md
//
// Not: Bu schema, kullanıcıların yapıştırdığı PRIMER + Mermaid DB şemasına göre
// sadeleştirilmiş çekirdek veri modelidir (Milestone-0 / iskelet).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum Role {
  SUPER_ADMIN
  ROOM
  COMPANY
  DRIVER
  PERSONEL
  PARENT
}

enum IdentityProvider {
  GOOGLE
}

enum InviteType {
  PERSONEL_INVITE
  DRIVER_INVITE
  ROOM_USER_INVITE
  COMPANY_USER_INVITE
  PARENT_INVITE
}

enum VehicleStatus {
  ACTIVE
  PASSIVE
  STALE
}

enum OfferDecision {
  PENDING
  ACCEPTED
  REJECTED
}

enum ShiftOfferStatus {
  OPEN
  COUNTERED
  ACCEPTED
  CANCELLED
}

enum VehicleType {
  MINIBUS
  MIDIBUS
  OTOBUS
}

enum OdometerSource {
  MANUAL
  GPS
}

enum ShiftStatus {
  DRAFT
  REQUESTED
  APPROVED
  ACTIVE
  REJECTED
  DONE
  SPLIT
}

enum StopType {
  COMMON
  MANUAL
}

enum StopState {
  PENDING
  REACHED
  SKIPPED
}

enum PickupRequestStatus {
  OPEN
  CANCELLED
  ACCEPTED
}

enum GpsLastStatus {
  OK
  STALE
}

enum GpsDeviceStatus {
  ACTIVE
  DISABLED
}

enum NotificationScope {
  ROOM
  COMPANY
  DRIVER
  USER
}

enum PenaltyType {
  NO_SHOW
}

enum PenaltyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// ✅ UI/WS status gate (notif dedupe/transition için)
enum UiGpsStatus {
  LIVE
  STALE
  OFFLINE
}

// ✅ M16.1: personel geocode cache
enum GeoStatus {
  OK
  NEEDS_REVIEW
  FAILED
}

// ✅ M17
enum AgreementStatus {
  REQUESTED
  COUNTERED
  APPROVED
  ACTIVE
  DONE
  CANCELLED
  REJECTED
}

// ✅ M57: agreement süre uzatma pazarlığı (Company teklif → Room karşı/kabul)
enum AgreementExtendStatus {
  NONE
  PENDING
  COUNTERED
  ACCEPTED
  REJECTED
}

// ✅ M19: directional routing + hub
enum ShiftDirection {
  INBOUND
  OUTBOUND
}

enum RoutePattern {
  ONE_WAY
  LOOP
}

// ✅ M51: shift süre uzatma akışı (Company talep → Room karar)
enum ShiftExtendDecision {
  PENDING
  ACCEPTED
  REJECTED
}

// --- Core Models ---

enum CompanyKind {
  COMPANY
  SCHOOL
  ORGANIZATION
}

enum ExternalReferenceDataClass {
  INTERNAL_ACTUAL
  EXTERNAL_REFERENCE
  DEMO_FIXTURE
}

enum ExternalReferenceFamily {
  FUEL_DIESEL
  FUEL_GASOLINE
  FUEL_LPG
  FX
  INFLATION_INDEX
  COST_INDEX
  TOLL
  BRIDGE
  TUNNEL
  FERRY
  MAINTENANCE_REFERENCE
  TYRE_REFERENCE
  VEHICLE_CLASS_REFERENCE
  REGIONAL_COST_REFERENCE
}

enum ExternalReferenceUnit {
  CURRENCY
  CURRENCY_PER_L
  CURRENCY_PER_KM
  CURRENCY_PER_MONTH
  CURRENCY_PER_TRIP
  CURRENCY_PER_UNIT
  RATE
  INDEX_POINT
}

enum ExternalReferenceFreshness {
  FRESH
  STALE
  EXPIRED
  SOURCE_UNAVAILABLE
  FALLBACK
  UNKNOWN
}

enum ExternalReferenceConfidence {
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

enum ExternalReferenceCompleteness {
  COMPLETE
  INCOMPLETE
}

enum ExternalReferenceConflictState {
  NO_CONFLICT
  CONFLICT
  UNKNOWN
}

enum ExternalReferenceProviderStatus {
  CONFIGURED
  NOT_CONFIGURED
  INVALID_CONFIG
  UNAVAILABLE
}

enum ExternalReferenceFallbackState {
  NONE
  FALLBACK_PROVIDER
  STALE_CACHE
  NO_SAFE_FALLBACK
}

enum ExternalReferenceScopeType {
  GLOBAL
  REGION
  CITY
  CUSTOM
}

model Company {
  kind         CompanyKind @default(COMPANY)
  id           Int         @id @default(autoincrement())
  name         String
  status       String      @default("ACTIVE")
  regionId     Int?
  region       Region?     @relation(fields: [regionId], references: [id])
  district     String? // ilçe (opsiyonel)
  // ✅ M36.4: profil alanları
  legalName    String? // resmi ünvan (opsiyonel)
  taxNo        String?
  taxOffice    String?
  addressLine  String? // adres (detay)
  contactName  String?
  contactPhone String?
  contactEmail String?
  notes        String?

  hubLat    Float? // company worksite hub (optional)
  hubLng    Float? // company worksite hub (optional)
  createdAt DateTime @default(now())

  users             User[]
  shifts            Shift[]
  personels         Personel[]
  notifications     Notification[]
  agreements        Agreement[]
  parentInvites     ParentInvite[]
  invites           Invite[]
  organizationPlans OrganizationPlan[]
  budgetPlans       CompanyBudgetPlan[]
  paymentAccounts   PaymentAccount[]
  commercialSources CommercialSource[]
  hakedisRecords    HakedisRecord[]
  invoiceRecords    InvoiceRecord[]

  @@index([regionId, kind])
  @@index([kind])
  @@index([regionId])
  @@index([district])
}

enum OrganizationPlanStatus {
  DRAFT
  SHIFT_PUBLISHED
  AGREEMENT_REQUESTED
  CANCELLED
}

model OrganizationPlan {
  id                Int                    @id @default(autoincrement())
  companyId         Int
  title             String                 @default("Organization Plan")
  planDate          DateTime               @default(now()) @db.Date
  startMin          Int                    @default(480)
  endMin            Int                    @default(1080)
  roomId            Int?
  notes             String?
  status            OrganizationPlanStatus @default(DRAFT)
  publishedShiftId  Int?
  linkedAgreementId Int?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stops   OrganizationStop[]
  shifts  Shift[]

  @@index([companyId, status])
  @@index([companyId, planDate])
  @@index([roomId])
}

model OrganizationStop {
  id             Int      @id @default(autoincrement())
  planId         Int
  name           String
  address        String?
  lat            Float
  lng            Float
  order          Int      @default(0)
  passengerCount Int      @default(1)
  windowStartMin Int?
  windowEndMin   Int?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  plan OrganizationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, order])
}

enum CompanyBudgetPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum RoomQuoteFloorDraftStatus {
  DRAFT
  APPLIED
  ARCHIVED
}

enum HakedisRecordStatus {
  DRAFT
  READY
  FINALIZED
  CANCELLED
}

enum InvoiceRecordStatus {
  DRAFT
  ISSUED
  CANCELLED
  PAID
}

enum PersonelKind {
  PERSONEL
  STUDENT
}

model Room {
  id           Int     @id @default(autoincrement())
  name         String
  status       String  @default("ACTIVE")
  regionId     Int?
  region       Region? @relation(fields: [regionId], references: [id])
  district     String? // ilçe (opsiyonel)
  // ✅ M36.4: profil alanları
  addressLine  String? // adres (detay)
  contactName  String?
  contactPhone String?
  contactEmail String?
  notes        String?

  // ✅ M19: worksite hub (company/site)
  hubLat    Float?
  hubLng    Float?
  createdAt DateTime @default(now())

  users          User[]
  vehicles       Vehicle[]
  drivers        Driver[]
  shifts         Shift[]
  notifications  Notification[]
  routeTemplates RouteTemplate[]
  agreements     Agreement[]
  invites        Invite[]

  // ✅ M24: offers inbox (Room ↔ ShiftOffer)
  shiftOffers ShiftOffer[] @relation("RoomShiftOffers")
  quoteFloorDrafts RoomQuoteFloorDraft[]
  commissionRules CommissionRule[]
  paymentAccounts PaymentAccount[]
  commercialSources CommercialSource[]
  hakedisRecords HakedisRecord[]
  invoiceRecords InvoiceRecord[]

  @@index([regionId])
  @@index([district])
}

model Region {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  companies Company[]
  rooms     Room[]
}

// #2: provider-neutral external reference history. This model is never used
// for tenant actuals, contracts, agreements, or demo fixture promotion.
model ExternalCostReference {
  id              Int                             @id @default(autoincrement())
  referenceKey    String                          @unique
  dataClass       ExternalReferenceDataClass      @default(EXTERNAL_REFERENCE)
  family          ExternalReferenceFamily
  valueDecimal    String
  valueMinor      Int?
  unit            ExternalReferenceUnit
  currencyCode    String?
  sourceName      String
  sourceUrl       String?
  providerKey     String
  providerVersion String?
  asOf            DateTime?
  regionCode      String?
  scopeType       ExternalReferenceScopeType      @default(GLOBAL)
  scopeKey        String                          @default("GLOBAL")
  freshness       ExternalReferenceFreshness      @default(UNKNOWN)
  confidence      ExternalReferenceConfidence     @default(UNKNOWN)
  completeness    ExternalReferenceCompleteness   @default(INCOMPLETE)
  conflictState   ExternalReferenceConflictState  @default(UNKNOWN)
  providerStatus  ExternalReferenceProviderStatus @default(CONFIGURED)
  fallbackState   ExternalReferenceFallbackState  @default(NONE)
  retrievedAt     DateTime                        @default(now())
  freshUntil      DateTime?
  staleUntil      DateTime?
  sourceMetadata  Json?
  rawPayloadHash  String?
  createdByUserId Int?
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt

  createdBy User? @relation("ExternalReferenceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([family, regionCode, scopeType, scopeKey])
  @@index([providerKey, family, asOf])
  @@index([freshness, staleUntil])
}

// Auth entity (login) — role taşıyıcı
model User {
  notifications Notification[]
  consents      Consent[]
  id            Int            @id @default(autoincrement())
  email         String         @unique
  passwordHash  String
  role          Role
  fullName      String
  phone         String?

  // ✅ M41: device binding (primarily for DRIVER)
  deviceId         String?
  deviceBoundAt    DateTime?
  deviceLastSeenAt DateTime?

  // ✅ M41: refresh sessions (rotating)
  refreshSessions RefreshSession[]

  // ✅ M46.9: session invalidation (access token sv claim)
  sessionVersion Int            @default(1)
  identities     UserIdentity[]

  // Step 1.5: TOTP step-up (ROOM + SUPER_ADMIN)
  totpSecretBase32        String?
  totpPendingSecretBase32 String?
  totpEnabledAt           DateTime?
  totpLastVerifiedAt      DateTime?

  createdAt DateTime @default(now())

  // Scope bindings
  companyId Int?
  roomId    Int?
  company   Company? @relation(fields: [companyId], references: [id])
  room      Room?    @relation(fields: [roomId], references: [id])

  // Optional profile links
  driver                 Driver?
  personel               Personel?
  // ✅ M16.1: import trail (createdBy)
  shiftImportsCreated    ShiftImport[]   @relation("ShiftImportCreatedBy")
  createdDriverPenalties DriverPenalty[] @relation("DriverPenaltyCreatedBy")
  parentChildren         ParentChild[]   @relation("ParentUserChildren")
  parentInvitesCreated   ParentInvite[]  @relation("ParentInviteCreatedBy")
  parentInvitesConsumed  ParentInvite[]  @relation("ParentInviteConsumedBy")
  invitesCreated         Invite[]        @relation("InviteCreatedBy")
  invitesConsumed        Invite[]        @relation("InviteConsumedBy")
  companyBudgetPlansCreated CompanyBudgetPlan[]      @relation("CompanyBudgetPlanCreatedBy")
  companyBudgetPlansUpdated CompanyBudgetPlan[]      @relation("CompanyBudgetPlanUpdatedBy")
  companyBudgetPlansActivated CompanyBudgetPlan[]    @relation("CompanyBudgetPlanActivatedBy")
  roomQuoteFloorDraftsCreated RoomQuoteFloorDraft[]   @relation("RoomQuoteFloorDraftCreatedBy")
  roomQuoteFloorDraftsUpdated RoomQuoteFloorDraft[]   @relation("RoomQuoteFloorDraftUpdatedBy")
  roomQuoteFloorDraftsApplied RoomQuoteFloorDraft[]   @relation("RoomQuoteFloorDraftAppliedBy")
  externalCostReferencesCreated ExternalCostReference[] @relation("ExternalReferenceCreatedBy")
  hakedisRecordsCreated HakedisRecord[] @relation("HakedisRecordCreatedBy")
  invoiceRecordsCreated InvoiceRecord[] @relation("InvoiceRecordCreatedBy")

  @@index([companyId])
  @@index([roomId])
}

model Vehicle {
  id            Int           @id @default(autoincrement())
  roomId        Int
  plate         String        @unique
  capacity      Int
  status        VehicleStatus @default(ACTIVE)
  speedLimitKmh Int           @default(80)
  agreements    Agreement[]

  // Opsiyonel: bu araca bağlı varsayılan driver
  driverId Int?

  // V1 meta (araç tanımı)
  type      VehicleType?
  brand     String?
  model     String?
  modelYear Int?
  color     String?
  vin       String?      @unique
  note      String?

  // Resmi tarihler
  inspectionDueAt DateTime?
  insuranceDueAt  DateTime?
  cascoDueAt      DateTime?

  // Bakım (tarih + km)
  lastServiceAt       DateTime?
  lastServiceKm       Int?
  serviceIntervalKm   Int       @default(15000)
  serviceIntervalDays Int?

  // Odometer
  odometerKm        Int?
  odometerUpdatedAt DateTime?
  odometerSource    OdometerSource @default(MANUAL)

  // Geriye dönük uyum: eski bakım alanı (UI'da opsiyonel gösterilebilir)
  nextMaintenanceAt DateTime?

  // ✅ Archive (shift bağlıyken "sil" => archive)
  archivedAt     DateTime?
  archivedReason String?

  createdAt DateTime @default(now())

  room              Room               @relation(fields: [roomId], references: [id])
  driver            Driver?            @relation(fields: [driverId], references: [id], onDelete: SetNull)
  gpsLast           GpsLast?
  gpsState          VehicleGpsState? // ✅ UI status gate state
  gpsDevices        GpsDevice[]
  gpsPoints         GpsPoint[]
  // ✅ M19: learned route samples
  routeLearnSamples RouteLearnSample[]
  shifts            Shift[]
  notifications     Notification[]

  @@index([roomId])
  @@index([roomId, archivedAt])
}

model Driver {
  id             Int         @id @default(autoincrement())
  roomId         Int
  fullName       String
  phone          String
  deviceInfo     String
  driverCode     String?     @unique
  pinTemporary   Boolean     @default(true)
  pinUpdatedAt   DateTime?
  backupDriverId Int?
  createdAt      DateTime    @default(now())
  agreements     Agreement[]

  room Room @relation(fields: [roomId], references: [id])

  vehicles Vehicle[]

  // Optional login user link (role=DRIVER)
  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id])

  // self-reference
  backupDriver Driver?  @relation("BackupDriver", fields: [backupDriverId], references: [id])
  backupsFor   Driver[] @relation("BackupDriver")

  shifts        Shift[]
  notifications Notification[]
  invites       Invite[]
  penalties     DriverPenalty[]

  @@index([roomId])
}

model Shift {
  id        Int         @id @default(autoincrement())
  companyId Int
  roomId    Int?
  vehicleId Int?
  driverId  Int?
  startAt   DateTime
  endAt     DateTime
  status    ShiftStatus @default(DRAFT)

  // M85/M86: auto split / child-shift meta
  requiredPaxOverride Int?
  splitRootId         Int?
  splitGroupKey       String?
  splitIndex          Int?
  splitTotal          Int?

  // ✅ M19: routing meta (worksite hub + direction/pattern)
  hubLat    Float?
  hubLng    Float?
  direction ShiftDirection @default(INBOUND)
  pattern   RoutePattern   @default(ONE_WAY)
  createdAt DateTime       @default(now())

  // M81+: DB-first route snapshot for preview
  routeSnapshotPolyline    String?
  routeSnapshotDistanceM   Int?
  routeSnapshotDurationSec Int?
  routeSnapshotValidatedAt DateTime?
  routeSnapshotInputHash   String?


  // COMPANY → ROOM teklif
  companyOfferVehicleId Int?
  companyOfferAmount    Int?
  companyOfferNote      String?

  // ROOM → COMPANY teklif
  roomOfferVehicleId  Int?
  roomOfferAmount     Int?
  roomOfferNote       String?
  roomOfferToDriver   Boolean @default(false)
  roomOfferDriverNote String?

  // COMPANY: room teklifine karar
  roomOfferDecision     OfferDecision @default(PENDING)
  roomOfferDecisionNote String?
  roomOfferDecisionAt   DateTime?

  // ✅ M51: süre uzatma (Company → Room talep, Room karar)
  extendRequestedEndAt DateTime?
  extendRequestedAt    DateTime?
  extendDecision       ShiftExtendDecision @default(PENDING)
  extendNoteCompany    String?
  extendNoteRoom       String?
  extendDecisionAt     DateTime?

  company Company  @relation(fields: [companyId], references: [id])
  room    Room?    @relation(fields: [roomId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])
  driver  Driver?  @relation(fields: [driverId], references: [id])

  stops          Stop[]
  pickupRequests PickupRequest[]
  progress       ShiftProgress?
  notifications  Notification[]

  // ✅ M24: marketplace offers
  offers ShiftOffer[]

  // ✅ M16.1
  people      ShiftPersonel[]
  imports     ShiftImport[]
  assignments StopAssignment[]

  // ✅ M18: agreement kaynaklı otomatik shift
  agreementId Int?
  agreement   Agreement? @relation(fields: [agreementId], references: [id], onDelete: SetNull)

  splitRoot     Shift?  @relation("ShiftSplitTree", fields: [splitRootId], references: [id], onDelete: SetNull)
  splitChildren Shift[] @relation("ShiftSplitTree")

  organizationPlanId Int?
  organizationPlan   OrganizationPlan? @relation(fields: [organizationPlanId], references: [id], onDelete: SetNull)

  // ✅ M19: learned route sample (1:1, generated after shift complete)
  routeLearnSample   RouteLearnSample?
  penalties          DriverPenalty[]
  checkinEvents      CheckinEvent[]
  passengerLiveLinks PassengerLiveLink[]
  commercialSourcesRoot CommercialSource[] @relation("CommercialSourceShiftRoot")

  @@unique([agreementId, startAt])
  @@index([companyId])
  @@index([roomId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([splitRootId])
  @@index([splitGroupKey])
  @@index([companyOfferVehicleId])
  @@index([companyOfferAmount])
  @@index([roomOfferDecision])
  @@index([roomOfferVehicleId])
  @@index([roomOfferAmount])
  @@index([extendDecision])
  @@index([agreementId])
  @@index([organizationPlanId])
}

model DriverPenalty {
  id              Int           @id @default(autoincrement())
  driverId        Int
  shiftId         Int?
  type            PenaltyType
  status          PenaltyStatus @default(ACTIVE)
  reason          String?
  startsAt        DateTime      @default(now())
  endsAt          DateTime
  createdByUserId Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  driver    Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  shift     Shift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  createdBy User   @relation("DriverPenaltyCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([shiftId])
  @@index([status])
  @@index([type])
  @@index([endsAt])
}

model PassengerLiveLink {
  id           Int       @id @default(autoincrement())
  shiftId      Int
  personelId   Int
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())

  shift    Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  personel Personel @relation(fields: [personelId], references: [id], onDelete: Cascade)

  @@index([shiftId, createdAt])
  @@index([personelId, createdAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

model ShiftOffer {
  id      Int              @id @default(autoincrement())
  shiftId Int
  roomId  Int
  status  ShiftOfferStatus @default(OPEN)

  // Company -> Room initial offer
  amountCompany Int?
  noteCompany   String?

  // Room -> Company counter offer
  amountRoom Int?
  noteRoom   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  room  Room  @relation("RoomShiftOffers", fields: [roomId], references: [id])
  quoteFloorDrafts RoomQuoteFloorDraft[] @relation("RoomQuoteFloorDraftAppliedOffer")

  @@unique([shiftId, roomId])
  @@index([shiftId])
  @@index([roomId])
  @@index([status])
}

model CompanyBudgetPlan {
  id                  Int                     @id @default(autoincrement())
  companyId           Int
  status              CompanyBudgetPlanStatus @default(DRAFT)
  currencyCode        String                  @default("TRY")
  budgetAmountMinor    Int?
  periodStart         DateTime?               @db.Date
  periodEnd           DateTime?               @db.Date
  budgetSource        String?
  budgetApprovalState String?
  description         String?
  warningThresholdBps Int?
  inputSnapshot       Json?
  version             Int                     @default(1)
  createdByUserId     Int?
  updatedByUserId     Int?
  activatedByUserId   Int?
  activatedAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User?   @relation("CompanyBudgetPlanCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy    User?   @relation("CompanyBudgetPlanUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  activatedBy  User?   @relation("CompanyBudgetPlanActivatedBy", fields: [activatedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([companyId, updatedAt])
  @@index([companyId, activatedAt])
}

model RoomQuoteFloorDraft {
  id                             Int                        @id @default(autoincrement())
  roomId                         Int
  status                         RoomQuoteFloorDraftStatus  @default(DRAFT)
  currencyCode                   String                     @default("TRY")
  manualBaselineOperationalCostMinor Int?
  targetContributionBps          Int?
  riskReserveBps                 Int?
  quoteFloorMinor                Int?
  quoteFloorPerPassengerMinor    Int?
  baselineSource                 String?
  inputSnapshot                  Json?
  calculationVersion             String                     @default("ROOM-PROFITABILITY-AND-QUOTE-FLOOR-01")
  version                        Int                        @default(1)
  createdByUserId                Int?
  updatedByUserId                Int?
  appliedByUserId                Int?
  appliedShiftOfferId            Int?
  appliedAt                      DateTime?
  createdAt                      DateTime                   @default(now())
  updatedAt                      DateTime                   @updatedAt

  room            Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy       User?       @relation("RoomQuoteFloorDraftCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy       User?       @relation("RoomQuoteFloorDraftUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  appliedBy       User?       @relation("RoomQuoteFloorDraftAppliedBy", fields: [appliedByUserId], references: [id], onDelete: SetNull)
  appliedShiftOffer ShiftOffer? @relation("RoomQuoteFloorDraftAppliedOffer", fields: [appliedShiftOfferId], references: [id], onDelete: SetNull)

  @@index([roomId, status])
  @@index([roomId, updatedAt])
  @@index([appliedShiftOfferId])
}

// ✅ M17
model Agreement {
  id        Int @id @default(autoincrement())
  companyId Int
  roomId    Int

  vehicleId Int?
  driverId  Int?

  // ✅ M19: routing meta (worksite hub + direction/pattern)
  hubLat    Float?
  hubLng    Float?
  direction ShiftDirection @default(INBOUND)
  pattern   RoutePattern   @default(ONE_WAY)

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  weekMask Int
  startMin Int
  endMin   Int

  status AgreementStatus @default(REQUESTED)

  companyOfferAmount Int?
  companyOfferNote   String?

  roomOfferAmount Int?
  roomOfferNote   String?

  // ✅ M57: agreement süre uzatma pazarlığı
  extendStatus           AgreementExtendStatus @default(NONE)
  extendRequestedEndDate DateTime?             @db.Date
  extendRequestedAt      DateTime?
  extendOfferAmount      Int?
  extendOfferNote        String?
  extendCounterAmount    Int?
  extendCounterNote      String?
  extendDecisionAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company  @relation(fields: [companyId], references: [id])
  room    Room     @relation(fields: [roomId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver  Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)

  // ✅ M18: agreement -> generated shifts
  shifts Shift[]
  commercialSources CommercialSource[]
  hakedisRecords HakedisRecord[]
  invoiceRecords InvoiceRecord[]

  @@index([companyId])
  @@index([roomId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([status])
  @@index([startDate, endDate])
}


enum PaymentMode {
  OFF
  OPTIONAL
  REQUIRED
}

// #3: durable internal evidence used by the read-only reconciliation preview.
// These records are not payment execution or accounting posting records.
model HakedisRecord {
  id              Int                @id @default(autoincrement())
  reference       String             @unique
  agreementId     Int
  companyId       Int
  roomId          Int
  periodStart     DateTime           @db.Date
  periodEnd       DateTime           @db.Date
  amountMinor     Int
  currencyCode    String             @default("TRY")
  status          HakedisRecordStatus @default(READY)
  calculationVersion String          @default("HAKEDIS-INVOICE-RECONCILIATION-PREVIEW-01")
  source          String?
  notes           String?
  createdByUserId Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("HakedisRecordCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([agreementId, periodStart, periodEnd, status])
  @@index([companyId, periodStart, periodEnd])
  @@index([roomId, periodStart, periodEnd])
}

model InvoiceRecord {
  id              Int                @id @default(autoincrement())
  reference       String             @unique
  agreementId     Int?
  companyId       Int
  roomId          Int?
  periodStart     DateTime           @db.Date
  periodEnd       DateTime           @db.Date
  amountMinor     Int
  currencyCode    String             @default("TRY")
  status          InvoiceRecordStatus @default(ISSUED)
  source          String?
  notes           String?
  issuedAt        DateTime?
  createdByUserId Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  agreement Agreement? @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  room      Room?      @relation(fields: [roomId], references: [id], onDelete: SetNull)
  createdBy User?      @relation("InvoiceRecordCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([agreementId, periodStart, periodEnd, status])
  @@index([companyId, periodStart, periodEnd])
  @@index([roomId, periodStart, periodEnd])
}

enum CommercialSourceType {
  AGREEMENT
  SHIFT_SERIES
}

enum CommissionScopeType {
  GLOBAL
  ROOM
}

enum SettlementPlanStatus {
  DORMANT
  READY
  ACTIVE
  DISABLED
}

enum SettlementEntryKind {
  COMPANY_CHARGE
  PLATFORM_COMMISSION
  PROVIDER_PAYOUT
}

enum SettlementEntryStatus {
  DORMANT
  PLANNED
  READY
  EXECUTED
  CANCELLED
}

enum PaymentAccountOwnerType {
  PLATFORM
  COMPANY
  ROOM
}

enum PaymentAccountStatus {
  INACTIVE
  ACTIVE
  VERIFIED
  ERROR
}

model CommissionRule {
  id            Int                 @id @default(autoincrement())
  scopeType     CommissionScopeType @default(GLOBAL)
  roomId        Int?
  paymentMode   PaymentMode         @default(OFF)
  commissionBps Int                 @default(0)
  isActive      Boolean             @default(true)
  note          String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  room Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([scopeType, isActive])
  @@index([roomId, isActive])
}

model PaymentAccount {
  id         Int                     @id @default(autoincrement())
  ownerType  PaymentAccountOwnerType
  companyId  Int?
  roomId     Int?
  providerKey String                 @default("DORMANT")
  status     PaymentAccountStatus    @default(INACTIVE)
  label      String?
  maskedIban String?
  accountRef String?
  metaJson   Json?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  room    Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([ownerType, status])
  @@index([companyId])
  @@index([roomId])
}

model CommercialSource {
  id                    Int                  @id @default(autoincrement())
  sourceType            CommercialSourceType
  sourceKey             String               @unique
  agreementId           Int?
  shiftRootId           Int?
  shiftGroupKey         String?
  companyId             Int
  roomId                Int?
  paymentModeSnapshot   PaymentMode          @default(OFF)
  commissionBpsSnapshot Int                  @default(0)
  amountCompanySnapshot Int?
  amountProviderSnapshot Int?
  currencyCode          String               @default("TRY")
  providerAdapterKey    String               @default("DORMANT")
  settlementStatus      SettlementPlanStatus @default(DORMANT)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  agreement Agreement? @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  shiftRoot Shift?     @relation("CommercialSourceShiftRoot", fields: [shiftRootId], references: [id], onDelete: SetNull)
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  room      Room?      @relation(fields: [roomId], references: [id], onDelete: SetNull)
  settlementPlans SettlementPlan[]

  @@index([sourceType, createdAt])
  @@index([agreementId])
  @@index([shiftRootId])
  @@index([companyId, createdAt])
  @@index([roomId, createdAt])
}

model SettlementPlan {
  id                    Int                  @id @default(autoincrement())
  commercialSourceId    Int
  status                SettlementPlanStatus @default(DORMANT)
  paymentModeSnapshot   PaymentMode          @default(OFF)
  commissionBpsSnapshot Int                  @default(0)
  providerAdapterKey    String               @default("DORMANT")
  grossAmount           Int                  @default(0)
  commissionAmount      Int                  @default(0)
  providerNetAmount     Int                  @default(0)
  currencyCode          String               @default("TRY")
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  commercialSource CommercialSource @relation(fields: [commercialSourceId], references: [id], onDelete: Cascade)
  entries          SettlementEntry[]

  @@index([commercialSourceId])
  @@index([status, createdAt])
}

model SettlementEntry {
  id               Int                   @id @default(autoincrement())
  settlementPlanId Int
  kind             SettlementEntryKind
  status           SettlementEntryStatus @default(DORMANT)
  amount           Int                   @default(0)
  currencyCode     String                @default("TRY")
  providerRef      String?
  note             String?
  dueAt            DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  settlementPlan SettlementPlan @relation(fields: [settlementPlanId], references: [id], onDelete: Cascade)

  @@index([settlementPlanId, kind])
  @@index([status, dueAt])
}

model Stop {
  id      Int      @id @default(autoincrement())
  shiftId Int
  name    String
  lat     Float
  lng     Float
  order   Int
  type    StopType

  state     StopState @default(PENDING)
  reachedAt DateTime?
  skippedAt DateTime?
  updatedAt DateTime  @updatedAt

  shift Shift @relation(fields: [shiftId], references: [id])

  // ✅ M16.1
  assignments StopAssignment[]

  @@index([shiftId, order])
  @@index([shiftId, state, order])
}

model RouteTemplate {
  id        Int      @id @default(autoincrement())
  roomId    Int
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  room  Room                @relation(fields: [roomId], references: [id])
  stops RouteTemplateStop[]

  @@index([roomId])
}

model RouteTemplateStop {
  id              Int      @id @default(autoincrement())
  routeTemplateId Int
  name            String
  lat             Float
  lng             Float
  order           Int
  type            StopType @default(COMMON)

  template RouteTemplate @relation(fields: [routeTemplateId], references: [id], onDelete: Cascade)

  @@unique([routeTemplateId, order])
  @@index([routeTemplateId, order])
}

// ✅ M16.1: Personel (geocode cache + optional lat/lng)
model Personel {
  id        Int          @id @default(autoincrement())
  companyId Int
  kind      PersonelKind @default(PERSONEL)
  userId    Int?         @unique

  // Master profile
  fullName    String
  phone       String?
  homeAddress String?
  homeLat     Float?
  homeLng     Float?

  // Geocode cache / review state
  geoStatus         GeoStatus @default(NEEDS_REVIEW)
  geoManualOverride Boolean   @default(false)
  geoNote           String?
  geoUpdatedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  pickupRequests PickupRequest[]

  // ✅ M16.1
  shiftImportRows ShiftImportRow[]
  shiftLinks      ShiftPersonel[]
  assignments     StopAssignment[]
  parentLinks     ParentChild[]    @relation("ParentChildPersonel")
  parentInvites   ParentInvite[]   @relation("ParentInviteChild")

  credentials        PersonelCredential[]
  checkinEvents      CheckinEvent[]
  passengerLiveLinks PassengerLiveLink[]
  invites            Invite[]             @relation("InvitePersonel")
  childInvites       Invite[]             @relation("InviteChildPersonel")

  @@unique([companyId, phone])
  @@index([companyId, kind])
  @@index([companyId])
}

model ShiftPersonel {
  id         Int      @id @default(autoincrement())
  shiftId    Int
  personelId Int
  note       String?
  createdAt  DateTime @default(now())

  shift    Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  personel Personel @relation(fields: [personelId], references: [id], onDelete: Cascade)

  @@unique([shiftId, personelId])
  @@index([shiftId])
  @@index([personelId])
}

model ShiftImport {
  id              Int      @id @default(autoincrement())
  shiftId         Int
  createdByUserId Int?
  fileName        String?
  createdAt       DateTime @default(now())

  shift     Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  createdBy User? @relation("ShiftImportCreatedBy", fields: [createdByUserId], references: [id])

  rows ShiftImportRow[]

  @@index([shiftId])
}

model ShiftImportRow {
  id         Int       @id @default(autoincrement())
  importId   Int
  rowNo      Int
  rawJson    Json?
  fullName   String?
  phone      String?
  address    String?
  lat        Float?
  lng        Float?
  geoStatus  GeoStatus @default(NEEDS_REVIEW)
  personelId Int?

  createdAt DateTime @default(now())

  import   ShiftImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  personel Personel?   @relation(fields: [personelId], references: [id])

  @@index([importId])
}

model StopAssignment {
  id         Int      @id @default(autoincrement())
  shiftId    Int
  stopId     Int
  personelId Int
  walkM      Int
  createdAt  DateTime @default(now())

  shift    Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  stop     Stop     @relation(fields: [stopId], references: [id], onDelete: Cascade)
  personel Personel @relation(fields: [personelId], references: [id], onDelete: Cascade)

  @@unique([shiftId, personelId])
  @@index([shiftId])
  @@index([stopId])
}

model PickupRequest {
  id         Int                 @id @default(autoincrement())
  shiftId    Int
  personelId Int
  lat        Float
  lng        Float
  status     PickupRequestStatus @default(OPEN)
  createdAt  DateTime            @default(now())

  shift    Shift    @relation(fields: [shiftId], references: [id])
  personel Personel @relation(fields: [personelId], references: [id])

  @@index([shiftId, status])
  @@index([personelId])
}

model GpsDevice {
  id            Int             @id @default(autoincrement())
  vehicleId     Int
  vendor        String
  serial        String
  label         String?
  status        GpsDeviceStatus @default(ACTIVE)
  authTokenHash String          @unique
  lastSeenAt    DateTime?
  lastIngestAt  DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vendor, serial])
  @@index([vehicleId, status])
  @@index([serial])
}

model GpsLast {
  vehicleId Int           @id
  lat       Float
  lng       Float
  speed     Float?
  at        DateTime
  status    GpsLastStatus @default(OK)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
}

// ✅ notif dedupe/transition gate için UI status state’i
model VehicleGpsState {
  vehicleId     Int         @id
  lastUiStatus  UiGpsStatus
  lastSource    String?
  lastChangedAt DateTime    @default(now())
  seenLiveAt    DateTime?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model GpsPoint {
  id        Int      @id @default(autoincrement())
  vehicleId Int
  lat       Float
  lng       Float
  speed     Float?
  at        DateTime
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, at])
  @@index([at])
}

// ✅ M19: learned route store (map-matched samples + canonical)
model RouteLearnSample {
  id              Int      @id @default(autoincrement())
  routeKey        String
  shiftId         Int
  vehicleId       Int
  startAt         DateTime
  polylineMatched String // JSON string: [{lat,lng}...]
  distanceKm      Float
  durationMin     Int
  qualityScore    Float
  createdAt       DateTime @default(now())

  shift   Shift   @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([shiftId])
  @@index([routeKey, createdAt])
  @@index([vehicleId, startAt])
}

model RouteLearned {
  routeKey           String   @id
  polylineCanonical  String // JSON string: [{lat,lng}...]
  distanceKmLearned  Float
  durationMinLearned Int
  sampleCount        Int
  updatedAt          DateTime @updatedAt
}

// Notification: scope bazlı (ROOM/COMPANY/DRIVER)
// payloadJson: Json tipinde serbest içerik
model Notification {
  id          Int               @id @default(autoincrement())
  type        String
  scope       NotificationScope
  payloadJson Json
  createdAt   DateTime          @default(now())
  dedupeKey   String?           @unique

  // optional targets
  companyId Int?
  roomId    Int?
  driverId  Int?
  userId    Int?
  vehicleId Int?
  shiftId   Int?

  company Company? @relation(fields: [companyId], references: [id])
  room    Room?    @relation(fields: [roomId], references: [id])
  driver  Driver?  @relation(fields: [driverId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])
  shift   Shift?   @relation(fields: [shiftId], references: [id])

  @@index([scope, createdAt])
  @@index([companyId, createdAt])
  @@index([roomId, createdAt])
  @@index([driverId, createdAt])
  @@index([userId, createdAt])
}

model ShiftProgress {
  id               Int       @id @default(autoincrement())
  shiftId          Int       @unique
  lastReachedOrder Int       @default(0)
  startedAt        DateTime?
  pausedAt         DateTime?
  completedAt      DateTime?
  updatedAt        DateTime  @updatedAt

  shift Shift @relation(fields: [shiftId], references: [id])
}

model ApiRequest {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  method     String
  path       String
  status     Int
  durationMs Int

  ip        String?
  userAgent String?

  userId Int?
  role   String?

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([path, createdAt])
  @@index([role, createdAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  actorUserId Int?
  actorRole   String?

  action   String
  entity   String
  entityId Int?
  meta     Json?

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([entity, entityId])
}

model UserIdentity {
  id              Int              @id @default(autoincrement())
  userId          Int
  provider        IdentityProvider
  providerSub     String
  email           String?
  emailVerifiedAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSub])
  @@index([userId])
  @@index([email])
}

model Invite {
  id               Int        @id @default(autoincrement())
  type             InviteType
  role             Role
  email            String?
  phone            String?
  fullName         String?
  companyId        Int?
  roomId           Int?
  personelId       Int?
  childPersonelId  Int?
  driverId         Int?
  tokenHash        String     @unique
  expiresAt        DateTime?
  consumedAt       DateTime?
  revokedAt        DateTime?
  createdByUserId  Int?
  consumedByUserId Int?
  createdAt        DateTime   @default(now())

  company       Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  room          Room?     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  personel      Personel? @relation("InvitePersonel", fields: [personelId], references: [id], onDelete: SetNull)
  childPersonel Personel? @relation("InviteChildPersonel", fields: [childPersonelId], references: [id], onDelete: SetNull)
  driver        Driver?   @relation(fields: [driverId], references: [id], onDelete: SetNull)
  createdBy     User?     @relation("InviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  consumedBy    User?     @relation("InviteConsumedBy", fields: [consumedByUserId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([companyId, createdAt])
  @@index([roomId, createdAt])
  @@index([personelId, createdAt])
  @@index([childPersonelId, createdAt])
  @@index([driverId, createdAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

model ParentChild {
  id           Int      @id @default(autoincrement())
  parentUserId Int
  personelId   Int
  createdAt    DateTime @default(now())

  parent User     @relation("ParentUserChildren", fields: [parentUserId], references: [id])
  child  Personel @relation("ParentChildPersonel", fields: [personelId], references: [id])

  @@unique([parentUserId, personelId])
  @@index([personelId])
}

model Consent {
  id         Int       @id @default(autoincrement())
  userId     Int
  role       Role?
  docKey     String
  docVersion String
  acceptedAt DateTime  @default(now())
  revokedAt  DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, docKey, docVersion])
  @@index([docKey, docVersion])
  @@index([acceptedAt])
}

// ✅ M41: refresh token sessions (rotating)
model RefreshSession {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // sha256(refreshTokenRaw)
  tokenHash String @unique

  deviceId  String?
  expiresAt DateTime
  revokedAt DateTime?

  replacedById Int?
  replacedBy   RefreshSession?  @relation("RefreshSessionRotation", fields: [replacedById], references: [id])
  replacedFrom RefreshSession[] @relation("RefreshSessionRotation")

  ip        String?
  userAgent String?

  @@index([userId, createdAt])
  @@index([deviceId])
  @@index([expiresAt])
}

enum CredentialType {
  QR
  NFC
}

enum CredentialStatus {
  ACTIVE
  REVOKED
}

enum CheckinEventType {
  BOARD
  ALIGHT
}

enum CheckinSource {
  QR
  NFC
  MANUAL
}

model PersonelCredential {
  id         Int              @id @default(autoincrement())
  personelId Int
  type       CredentialType
  tokenHash  String           @unique
  status     CredentialStatus @default(ACTIVE)
  issuedAt   DateTime         @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?

  personel Personel @relation(fields: [personelId], references: [id], onDelete: Cascade)

  @@index([personelId])
  @@index([status])
}

model CheckinEvent {
  id         Int              @id @default(autoincrement())
  shiftId    Int
  personelId Int
  eventType  CheckinEventType
  source     CheckinSource
  at         DateTime         @default(now())
  deviceId   String?
  meta       Json?

  shift    Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  personel Personel @relation(fields: [personelId], references: [id], onDelete: Cascade)

  @@index([shiftId, at])
  @@index([personelId, at])
  @@index([shiftId, personelId, eventType, at])
}

model ParentInvite {
  id               Int       @id @default(autoincrement())
  companyId        Int
  childPersonelId  Int
  parentFullName   String?
  email            String?
  phone            String?
  tokenHash        String    @unique
  expiresAt        DateTime?
  consumedAt       DateTime?
  revokedAt        DateTime?
  createdByUserId  Int?
  consumedByUserId Int?
  createdAt        DateTime  @default(now())

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  child      Personel @relation("ParentInviteChild", fields: [childPersonelId], references: [id], onDelete: Cascade)
  createdBy  User?    @relation("ParentInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  consumedBy User?    @relation("ParentInviteConsumedBy", fields: [consumedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([childPersonelId, createdAt])
  @@index([email])
}
