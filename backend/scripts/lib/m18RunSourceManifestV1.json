{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "M18-RUN-SOURCE-MANIFEST-V1",
  "title": "M18 run-scoped source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "repoRoot",
    "branch",
    "headSha",
    "expectedHeadSha",
    "worktreeDirty",
    "trackedStatus",
    "untrackedRepoOwnedFiles",
    "ignoredRelevantFiles",
    "ownerTopology",
    "runtimeOwnerFiles",
    "runtimeLaunch",
    "authority"
  ],
  "properties": {
    "schemaVersion": { "const": "M18-RUN-SOURCE-MANIFEST-V1" },
    "runId": { "type": "string", "minLength": 1 },
    "repoRoot": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "headSha": { "type": "string", "pattern": "^[A-Fa-f0-9]{40}$" },
    "expectedHeadSha": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[A-Fa-f0-9]{40}$" }
      ]
    },
    "worktreeDirty": { "type": "boolean" },
    "trackedStatus": { "type": "array", "items": { "type": "object" } },
    "untrackedRepoOwnedFiles": { "type": "array", "items": { "type": "object" } },
    "ignoredRelevantFiles": { "type": "array", "items": { "type": "object" } },
    "ownerTopology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registryVersion",
        "canonicalOwners",
        "unknownOwners",
        "unexpectedOwners",
        "missingOwners"
      ],
      "properties": {
        "registryVersion": { "type": "string", "minLength": 1 },
        "canonicalOwners": { "type": "array" },
        "unknownOwners": { "type": "array" },
        "unexpectedOwners": { "type": "array" },
        "missingOwners": { "type": "array" },
        "duplicateOwners": { "type": "array" }
      }
    },
    "runtimeOwnerFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relativePath",
          "ownerClass",
          "lifecycleClass",
          "gitState",
          "rawSha256"
        ],
        "properties": {
          "relativePath": { "type": "string", "minLength": 1 },
          "ownerClass": { "type": "string", "minLength": 1 },
          "lifecycleClass": { "type": "string", "minLength": 1 },
          "gitState": { "type": "string", "minLength": 1 },
          "rawSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
        }
      }
    },
    "runtimeLaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint",
        "workingDirectory",
        "port",
        "authorityMode",
        "launchCommand",
        "launchCommandSha256"
      ],
      "properties": {
        "entrypoint": { "type": "string", "minLength": 1 },
        "workingDirectory": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "authorityMode": { "const": "NEW" },
        "launchCommand": { "type": "string", "minLength": 1 },
        "launchCommandSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticAuthorityMode",
        "liveAuthoritativePath",
        "semanticAuthorityCount",
        "shadowSemanticAuthorityCount",
        "runtimeFallbackCount",
        "downstreamSemanticRedecisionCount"
      ],
      "properties": {
        "semanticAuthorityMode": { "const": "NEW" },
        "liveAuthoritativePath": { "const": "NEW_TYPED_EVIDENCE" },
        "semanticAuthorityCount": { "const": 1 },
        "shadowSemanticAuthorityCount": { "const": 0 },
        "runtimeFallbackCount": { "const": 0 },
        "downstreamSemanticRedecisionCount": { "const": 0 }
      }
    },
    "sourceIdentityDigest": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "createdAt": { "type": "string", "minLength": 1 },
    "manifestSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
  }
}
